# Light counterpart of tinted-schemes' "colors" (clrs.cc, mrmrs). The grey ramp
# is reversed, with base03 at #767676 so comments reach 4.5:1 on white. Accents
# keep their hue and are darkened only until they reach 4.5:1 on white; blue,
# purple and maroon already did and are unchanged.
{
  base00 = "ffffff";
  base01 = "eeeeee";
  base02 = "dddddd";
  base03 = "767676";
  base04 = "555555";
  base05 = "333333";
  base06 = "222222";
  base07 = "111111";

  base08 = "db382e"; # red ff4136
  base09 = "b55e13"; # orange ff851b
  base0A = "877500"; # yellow ffdc00
  base0B = "1e872a"; # green 2ecc40
  base0C = "487d91"; # aqua 7fdbff
  base0D = "0074d9"; # blue
  base0E = "b10dc9"; # purple
  base0F = "85144b"; # maroon
}
